digraph C4Deployment {
  graph [rankdir=TB, newrank=true, bgcolor="white", pad="0.30", nodesep="0.32", ranksep="0.46", splines=polyline, fontname="Segoe UI", fontsize=18, labelloc="t", label="C4 | Despliegue objetivo · región primaria\nAlta disponibilidad en dos zonas"];
  node [shape=box, style="rounded,filled", fontname="Segoe UI", fontsize=9.8, margin="0.17,0.11", color="#58758B", fontcolor="#153A53", penwidth=1.3];
  edge [fontname="Segoe UI", fontsize=8.1, color="#688196", fontcolor="#486276", penwidth=1.0, arrowsize=0.62];

  users [label="Clientes web y móvil", fillcolor="#F1F5F8"];
  cdn [label="CloudFront + WAF\nTLS · reglas administradas", fillcolor="#FFF6E8", color="#C08329"];
  apigw [label="API Gateway REST\nCuotas · throttling · JWT", fillcolor="#FFF6E8", color="#C08329"];

  subgraph cluster_region {
    label="Región primaria · VPC privada · Multi-AZ";
    style="rounded,dashed"; color="#1670B8"; fontname="Segoe UI"; fontsize=11; fontcolor="#1670B8"; penwidth=1.5;
    alb [label="ALB interno\nVPC Link V2 · HTTPS", fillcolor="#F1F5F8"];
    subgraph cluster_az_a {
      label="Zona A"; style="rounded"; color="#9CB5C7"; fontname="Segoe UI"; fontsize=9;
      task_a [label="ECS Fargate\nAPI · zona A", fillcolor="#E6F1F8"];
      nat_a [label="NAT Gateway A\nSalida privada", fillcolor="#F1F5F8"];
    }
    subgraph cluster_az_b {
      label="Zona B"; style="rounded"; color="#9CB5C7"; fontname="Segoe UI"; fontsize=9;
      task_b [label="ECS Fargate\nAPI · zona B", fillcolor="#E6F1F8"];
      nat_b [label="NAT Gateway B\nSalida privada", fillcolor="#F1F5F8"];
    }
    rds_a [label="RDS PostgreSQL\nPrimario Multi-AZ", fillcolor="#F1F5F8"];
    rds_b [label="RDS PostgreSQL\nStandby", fillcolor="#F1F5F8"];
    events [label="EventBridge + SQS\nReintentos · DLQ", fillcolor="#FFF6E8", color="#C08329"];
    ddb [label="DynamoDB\nProyección de lectura", fillcolor="#F1F5F8"];
    audit [label="S3 Object Lock\nAuditoría protegida", fillcolor="#F1F5F8"];
    monitor [label="CloudWatch · X-Ray · CloudTrail\nTelemetría · alarmas · escalado", fillcolor="#FFF6E8", color="#C08329"];
  }

  users -> cdn [label="HTTPS"];
  cdn -> apigw [label="HTTPS"];
  apigw -> alb [label="VPC Link V2"];
  alb -> task_a [label="distribuye tráfico"];
  alb -> task_b [label="distribuye tráfico"];
  task_a -> rds_a [label="SQL/TLS"];
  task_b -> rds_a [label="SQL/TLS"];
  rds_a -> rds_b [label="replicación síncrona"];
  task_a -> events [label="outbox"];
  task_b -> events [label="outbox"];
  events -> ddb [label="proyección"];
  events -> audit [label="retención"];
  task_a -> monitor [style=dashed, label="métricas / trazas"];
  task_b -> monitor [style=dashed, label="métricas / trazas"];
  nat_a -> nat_b [style=invis, weight=5];

  note [shape=note, label="Health checks reemplazan tareas; ECS escala según demanda y alarmas.\nEste entorno es una propuesta, aún no desplegada. RTO/RPO se acuerdan y prueban aparte.", fontsize=8.5, fillcolor="#FFF7E8", color="#C08329"];
  {rank=sink; note}
}
