digraph C4Recovery {
  graph [rankdir=LR, bgcolor="white", pad="0.36", nodesep="0.54", ranksep="0.95", splines=polyline, fontname="Segoe UI", fontsize=20, labelloc="t", label="C4 | Recuperación ante desastres\nCopias entre regiones y recuperación controlada"];
  node [shape=box, style="rounded,filled", fontname="Segoe UI", fontsize=11, margin="0.22,0.15", color="#58758B", fontcolor="#153A53", penwidth=1.4];
  edge [fontname="Segoe UI", fontsize=9.5, color="#688196", fontcolor="#486276", penwidth=1.2, arrowsize=0.72];

  subgraph cluster_primary {
    label="Región primaria · producción objetivo";
    style="rounded,dashed"; color="#1670B8"; fontname="Segoe UI"; fontsize=12; fontcolor="#1670B8";
    rds [label="RDS Multi-AZ\nBackups · point-in-time recovery", fillcolor="#F1F5F8"];
    s3 [label="S3 Object Lock\nAuditoría protegida", fillcolor="#F1F5F8"];
    {rank=same; rds; s3}
  }
  subgraph cluster_dr {
    label="Región secundaria · DR objetivo";
    style="rounded,dashed"; color="#B86E13"; fontname="Segoe UI"; fontsize=12; fontcolor="#A6630F";
    replicas [label="Copias cifradas\nRDS · S3 según RPO", fillcolor="#F1F5F8"];
    iac [label="Infraestructura como código\nRed · servicios · políticas IAM", fillcolor="#FFF6E8", color="#C08329"];
    restore [label="Runbook de recuperación\nRestaurar · validar · redirigir tráfico", fillcolor="#FFF6E8", color="#C08329"];
    {rank=same; replicas; iac; restore}
  }
  goals [label="Objetivos por acordar\nRTO · RPO · pruebas periódicas", fillcolor="#FFF7E8", color="#C08329"];

  rds -> replicas [label="replica / backup cifrado"];
  s3 -> replicas [label="replicación entre regiones"];
  replicas -> restore [label="recuperación controlada"];
  iac -> restore [label="aprovisiona entorno"];
  restore -> goals [label="ensayo y evidencia"];
}
