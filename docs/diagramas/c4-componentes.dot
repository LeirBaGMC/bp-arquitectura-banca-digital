digraph C4Components {
  graph [rankdir=TB, newrank=true, bgcolor="white", pad="0.28", nodesep="0.32", ranksep="0.45", splines=polyline, fontname="Segoe UI", fontsize=18, labelloc="t", label="C4 | Componentes de la API BP Digital\nDetalle de un contenedor: API ASP.NET Core"];
  node [shape=box, style="rounded,filled", fontname="Segoe UI", fontsize=9.8, margin="0.17,0.11", color="#58758B", fontcolor="#153A53", penwidth=1.3];
  edge [fontname="Segoe UI", fontsize=8.2, color="#688196", fontcolor="#486276", penwidth=1.05, arrowsize=0.64];

  clients [label="SPA web / App móvil", fillcolor="#F1F5F8"];
  gateway [label="API Gateway + WAF\nEntrada · TLS · límites", fillcolor="#FFF6E8", color="#C08329"];

  subgraph cluster_api {
    label="Contenedor · API ASP.NET Core";
    style="rounded,dashed"; color="#1670B8"; fontname="Segoe UI"; fontsize=11; fontcolor="#1670B8"; penwidth=1.5;
    controllers [label="Controllers\nContratos REST · validación", fillcolor="#E6F1F8"];
    auth [label="Autorización\nJWT · issuer · audience\nscope · sub · ACR/AMR", fillcolor="#F1F5F8"];
    usecases [label="Casos de uso\nOrquestación · idempotencia", fillcolor="#E6F1F8"];
    domains [label="Servicios de dominio\nClientes · movimientos\nTransferencias · onboarding", fillcolor="#E6F1F8"];
    adapters [label="Puertos y adaptadores\nCore · detalle · pagos · facial", fillcolor="#F1F5F8"];
    repositories [label="Repositorios\nSQL parametrizado · transacción", fillcolor="#F1F5F8"];
    audit [label="Interceptor de auditoría\nActor · acción · resultado", fillcolor="#FFF6E8", color="#C08329"];
    outbox [label="Outbox transaccional\nEvento durable · reintento", fillcolor="#FFF6E8", color="#C08329"];

    controllers -> auth [label="valida token"];
    auth -> usecases [label="claims verificados"];
    usecases -> domains [label="ejecuta operación"];
    domains -> adapters [label="integra proveedores"];
    domains -> repositories [label="consulta / transacción"];
    domains -> audit [label="registra acciones"];
    repositories -> outbox [label="misma transacción"];
    audit -> outbox [label="sin secretos ni biometría"];
  }

  rds [label="RDS PostgreSQL\nFuente transaccional", fillcolor="#F1F5F8"];
  ddb [label="DynamoDB\nProyección de lectura", fillcolor="#F1F5F8"];
  core [label="Core bancario", fillcolor="#F7F9FB"];
  detail [label="Sistema de detalle", fillcolor="#F7F9FB"];
  payments [label="Red de pagos", fillcolor="#F7F9FB"];
  face [label="Proveedor facial", fillcolor="#F7F9FB"];
  bus [label="EventBridge + SQS\nColas separadas · DLQ", fillcolor="#FFF6E8", color="#C08329"];
  consumers [label="Consumidores independientes\nAuditoría · notificaciones", fillcolor="#E6F1F8"];
  auditstore [label="S3 Object Lock", fillcolor="#F1F5F8"];
  notify [label="Push · correo\nFCM/APNs · SES", fillcolor="#F7F9FB"];

  clients -> gateway [label="HTTPS / JSON"];
  gateway -> controllers [label="ruta protegida"];
  repositories -> rds [label="SQL/TLS"];
  domains -> ddb [label="lectura frecuente"];
  adapters -> core [label="datos básicos"];
  adapters -> detail [label="movimientos / perfil"];
  adapters -> payments [label="instrucción de pago"];
  adapters -> face [label="sesión autenticada"];
  outbox -> bus [label="publica evento"];
  bus -> consumers [label="reintento · DLQ"];
  consumers -> auditstore [label="registros protegidos"];
  consumers -> notify [label="entrega multicanal"];

  {rank=same; clients}
  {rank=same; gateway}
  {rank=same; controllers}
  {rank=same; auth}
  {rank=same; usecases}
  {rank=same; domains}
  {rank=same; adapters; repositories; audit}
  {rank=same; outbox}
  {rank=same; rds; ddb; core; detail; payments; face; bus}
  {rank=same; consumers; auditstore; notify}

  key [shape=note, label="API Gateway queda fuera del contenedor. Los servicios externos aparecen como dependencias directas.\nMVP local con SQLite; el contenedor cloud es objetivo.", fontsize=8.5, fillcolor="#FFF7E8", color="#C08329"];
  {rank=sink; key}
}
