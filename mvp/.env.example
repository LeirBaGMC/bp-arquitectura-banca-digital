# Configuración local. Este archivo no contiene credenciales.
APP_PORT=5080

# Completar al configurar Cognito y la API para un despliegue AWS.
# La SPA usa estos valores públicos durante la compilación del frontend.
# El backend recibe los valores equivalentes como Authentication__* en el entorno de ejecución.
# VITE_COGNITO_AUTHORITY=https://cognito-idp.<region>.amazonaws.com/<user-pool-id>
# VITE_COGNITO_DOMAIN=https://<domain>.auth.<region>.amazoncognito.com
# VITE_COGNITO_CLIENT_ID=<public-app-client-id>
# VITE_COGNITO_REDIRECT_URI=http://localhost:5173/
# VITE_COGNITO_SCOPE=bp/banking-api
# Authentication__Authority=https://cognito-idp.<region>.amazonaws.com/<user-pool-id>
# Authentication__Domain=https://<domain>.auth.<region>.amazoncognito.com
# Set the API allowlist to both public clients using indexed environment keys:
# Authentication__ClientIds__0=<mobile-client-id>
# Authentication__ClientIds__1=<spa-client-id>
# Authentication__RequiredScope=bp/banking-api
