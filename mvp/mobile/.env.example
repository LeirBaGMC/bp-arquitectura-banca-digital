# Android emulator: use 10.0.2.2 to reach the host machine.
# For a physical device, replace this with the computer's LAN address.
EXPO_PUBLIC_API_URL=http://10.0.2.2:5080

# Configure the Cognito hosted UI domain and public app client.
EXPO_PUBLIC_COGNITO_DOMAIN=
EXPO_PUBLIC_COGNITO_CLIENT_ID=
EXPO_PUBLIC_COGNITO_SCOPE=bp/banking-api

# Development only. Enable local API identity only in local development.
EXPO_PUBLIC_LOCAL_AUTH=false
